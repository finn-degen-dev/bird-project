+    plt.xlabel("Time (seconds)")
+    plt.ylabel("Species")
+    plt.grid(True, linestyle='--', alpha=0.5)
+    plt.tight_layout()
+    plt.savefig(output_path)
+    print(f"Timeline saved to {output_path}")
+
+def main():
