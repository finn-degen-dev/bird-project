            if(!hasHistory) histTbody.innerHTML = "<tr><td colspan='3'>Noch keine Daten</td></tr>";

            updateTimelineChart(payload.history);
            if(Object.keys(payload.stats).length > 0) updateStatsChart(payload.stats);
        };
