+def make_delta(
+    input_tensor: torch.Tensor
+):
+    input_tensor = input_tensor.transpose(3,2)
+    input_tensor = compute_deltas(input_tensor)
+    input_tensor = input_tensor.transpose(3,2)
+    return input_tensor
+
+
+def image_delta(x):
+    delta_1 = make_delta(x)
+    delta_2 = make_delta(delta_1)
+    x = torch.cat([x,delta_1,delta_2], dim=1)
+    return x
