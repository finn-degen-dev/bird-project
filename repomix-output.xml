SAMPLE_RATE = 32000
DURATION = 5
N_MELS = 128
FMAX = 16000
IMG_SIZE = 224
HOP_LENGTH = 512

TARGET_WIDTH = int((SAMPLE_RATE * DURATION) / HOP_LENGTH) + 1

XC_SPECIES_LOCATION = "cnt:germany"

