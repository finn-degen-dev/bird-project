            }

            var histTbody = document.getElementById("history-table");
            histTbody.innerHTML = "";
            var hasHistory = false;
            for (var ip in payload.history) {
                var items = [...payload.history[ip]].reverse();
                items.forEach(function(item) {
                    hasHistory = true;
                    var tr = document.createElement("tr");
